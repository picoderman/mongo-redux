{
  "name": "@tt-tt/mongo-redux",
  "version": "0.1.0",
  "description": "Synchronize one Redux root state with one MongoDB document.",
  "module": "./src/root.ts",
  "types": "./src/root.ts",
  "exports": {
    ".": {
      "types": "./src/root.ts",
      "import": "./src/root.ts"
    }
  },
  "type": "module",
  "files": [
    "src",
    "example"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": "Ilya Pavlov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/picoderman/mongo-redux.git"
  },
  "bugs": {
    "url": "https://github.com/picoderman/mongo-redux/issues"
  },
  "homepage": "https://github.com/picoderman/mongo-redux#readme",
  "keywords": [
    "mongodb",
    "redux",
    "synchronization",
    "state-management",
    "bun"
  ],
  "scripts": {
    "test-cleanup": "container ls -q | grep '^mongo-redux-test-' | xargs container stop; container ls -a -q | grep '^mongo-redux-test-' | xargs container rm",
    "test": "bun run test-cleanup; bun test --parallel"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": ">=7",
    "@reduxjs/toolkit": ">=2.0.0",
    "mongodb": ">=7.0.0",
    "redux": ">=5.0.0"
  }
}
